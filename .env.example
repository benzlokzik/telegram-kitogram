# Telegram Bot Configuration
# Copy this file to .env and fill in your actual values

# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Spam detection threshold (0.0 to 1.0, default: 0.95)
SPAM_THRESHOLD=0.95

# Trained transformer model and immutable Hugging Face revision
# If changing the repository, also set a revision from that repository.
SPAM_MODEL_ID=benzlokzik/spam-detector-bert
SPAM_MODEL_REVISION=3dd73bd4dcff411d44e1bc1a8e90d0568ca04395

# Database configuration
DB_PATH=bot_messages.db

# Log configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/bot.log

# Allowed admins (comma-separated user IDs)
ADMIN_USER_IDS=1234567890,0987654321
